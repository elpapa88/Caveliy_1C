#совместимость 10.0

конст значениеѕузанскогошагабольшого = 1

метод здрави€нашемусуше()
    знч им€ќтцаЌашего =  онсоль.—читать—троку("«драви€ ¬ам, дорогой ќтец, одинокий кормилец наш, как к ¬ам обращатьс€?\н")
     онсоль.«аписать("ƒа здравствует наш %им€ќтцаЌашего! —лавс€, ќтче наш!")
;

метод перевести√нилуюјмерикуЌаЌаш–одной–усский()
    знч гниль =  онсоль.—читать„исло("Ѕыстрее, признавайс€, сколько:\н")
    знч св€тонаше = (гниль - 32) * 5 / 9
     онсоль.«аписать("%гниль F∞; %св€тонаше C∞.") 
;

метод формуласледствиеизтеоремызоркогоглаза()
    знч бабки =  онсоль.—читать„исло("¬ведите вашу «ѕ:\н")
    знч дарбожий =  онсоль.—читать„исло("¬ведите общую сумму подарка от коллег на ¬аше ƒ–:\н")
    знч дружеска€близость =  онсоль.—читать„исло("¬ведите коэффициент рабочей близости:\н")
    знч романтическа€близость =  онсоль.—читать„исло("¬ведите коэффициент личной близости:\н")
     онсоль.«аписать((бабки / 500 + дарбожий / 100) * дружеска€близость * романтическа€близость)
;

метод сушинскийсуд()
    знч –осси€ѕузанѕобеда =  онсоль.—читать„исло("¬веди высоту пирамидки:\н")
    дл€ кокосовоемолоко = значениеѕузанскогошагабольшого по –осси€ѕузанѕобеда шаг значениеѕузанскогошагабольшого
        пер космосы = ""
        дл€ пчелка = значениеѕузанскогошагабольшого по –осси€ѕузанѕобеда-кокосовоемолоко шаг значениеѕузанскогошагабольшого
            космосы = космосы + " "
        ;
        пер емель€нчики = ""
        дл€ жужелица = значениеѕузанскогошагабольшого по (значениеѕузанскогошагабольшого*2 * кокосовоемолоко - значениеѕузанскогошагабольшого) шаг значениеѕузанскогошагабольшого
            емель€нчики = емель€нчики + "+"
        ;
         онсоль.«аписать(космосы + емель€нчики)
    ;
;
