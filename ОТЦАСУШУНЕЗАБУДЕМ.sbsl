#совместимость 10.0

конст значениеПузанскогошагабольшого = 1

метод здравиянашемусуше()
    знч имяОтцаНашего = Консоль.СчитатьСтроку("Здравия Вам, дорогой Отец, одинокий кормилец наш, как к Вам обращаться?\н")
    Консоль.Записать("Да здравствует наш %имяОтцаНашего! Слався, Отче наш!")
;

метод перевестиГнилуюАмерикуНаНашРоднойРусский()
    знч гниль = Консоль.СчитатьЧисло("Быстрее, признавайся, сколько:\н")
    знч святонаше = (гниль - 32) * 5 / 9
    Консоль.Записать("%гниль F°; %святонаше C°.") 
;

метод формуласледствиеизтеоремызоркогоглаза()
    знч бабки = Консоль.СчитатьЧисло("Введите вашу ЗП:\н")
    знч дарбожий = Консоль.СчитатьЧисло("Введите общую сумму подарка от коллег на Ваше ДР:\н")
    знч дружескаяблизость = Консоль.СчитатьЧисло("Введите коэффициент рабочей близости:\н")
    знч романтическаяблизость = Консоль.СчитатьЧисло("Введите коэффициент личной близости:\н")
    Консоль.Записать((бабки / 500 + дарбожий / 100) * дружескаяблизость * романтическаяблизость)
;

метод сушинскийсуд()
    знч РоссияПузанПобеда = Консоль.СчитатьЧисло("Введи высоту пирамидки:\н")
    для кокосовоемолоко = значениеПузанскогошагабольшого по РоссияПузанПобеда шаг значениеПузанскогошагабольшого
        пер космосы = ""
        для пчелка = значениеПузанскогошагабольшого по РоссияПузанПобеда-кокосовоемолоко шаг значениеПузанскогошагабольшого
            космосы = космосы + " "
        ;
        пер емельянчики = ""
        для жужелица = значениеПузанскогошагабольшого по (значениеПузанскогошагабольшого*2 * кокосовоемолоко - значениеПузанскогошагабольшого) шаг значениеПузанскогошагабольшого
            емельянчики = емельянчики + "+"
        ;
        Консоль.Записать(космосы + емельянчики)
    ;
;
